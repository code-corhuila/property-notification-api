# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=3005
# Public key of identity-service (one line, \n escapes) — or JWT_PUBLIC_KEY_FILE.
# In develop, property-infra-postgres/scripts/dev-keys.sh generates a pair.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# The schema notification (property-notification-db). Required: without it the service does not start.
# PERSISTENCE=memory (in-memory, nothing persists) is for tests and local development only.
PERSISTENCE=postgres
DATABASE_URL=
DATABASE_USER=notification_app
DATABASE_PASSWORD=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# The consumer of notification.reservas (java -jar notification-app.jar --reservas-consumer).
# Without BROKER_PASSWORD, SERVICE_TOKEN (svc-notification) or MAIL_HOST it does not start.
BROKER_HOST=localhost
BROKER_PORT=5672
BROKER_USER=notification
BROKER_PASSWORD=
IDENTITY_URL=http://localhost:3004
SERVICE_TOKEN=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_STARTTLS=false
MAIL_FROM=no-reply@pms-property.test
# Integration tests run only when TEST_DATABASE_URL is set (Annex C); scripts/test-db.sh prepares one.
TEST_DATABASE_URL=
TEST_DATABASE_USER=notification_app
TEST_DATABASE_PASSWORD=
